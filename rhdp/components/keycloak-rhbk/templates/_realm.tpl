{{/* Client scope mappings: receiving client -> role-container client roles. */}}
{{- define "box1.clientScopeMappings" -}}
agentic-operations-cli:
- client: agentic-operations
  roles:
  - aiops-viewer
  - aiops-analyst
operations-console:
- client: scenario-controller
  roles:
  - scenario-viewer
  - scenario-operator
- client: asset-service
  roles:
  - telemetry-reader
- client: agentic-operations
  roles:
  - aiops-viewer
  - aiops-analyst
scenario-controller-cli:
- client: scenario-controller
  roles:
  - scenario-viewer
  - scenario-operator
scenario-controller:
- client: inventory-service
  roles:
  - inventory-admin
site-east:
- client: asset-service
  roles:
  - site-reporter
site-west:
- client: asset-service
  roles:
  - site-reporter

{{- end -}}
