{{/* Realm content for kcadm partialImport (clients and roles). Client secrets are generated by Keycloak and published by the reconcile Job. */}}
{{- define "box1.realm" -}}
id: {{ .Values.keycloak.realm }}
realm: {{ .Values.keycloak.realm }}
enabled: true
displayName: Box1
sslRequired: external
registrationAllowed: false
roles:
  realm:
  - name: openshell-user
    description: OpenShell standard user
  - name: openshell-admin
    description: OpenShell administrator
  - name: rhtpa-admin
    description: RHTPA document and importer administration
  client:
    agentic-operations:
    - name: aiops-viewer
      description: Read evidence and analyses through REST and MCP
      clientRole: true
    - name: aiops-analyst
      description: aiops-viewer, plus start analyses (which propose actions only
        and never execute them)
      clientRole: true
    asset-service:
    - name: chaos-operator
      description: Use the asset telemetry load and chaos console and its control
        API
      clientRole: true
    - name: telemetry-writer
      description: Post readings to the asset telemetry ingestion API
      clientRole: true
    - name: telemetry-reader
      description: Read readings and alerts from the asset telemetry API
      clientRole: true
    - name: site-reporter
      description: Write the site's own status (PUT /api/v1/sites/{siteId}/status);
        edge site clients only
      clientRole: true
    fulfillment-adapter:
    - name: fulfillment-writer
      description: Create fulfillment requests and run operator reconcile on the
        fulfillment adapter
      clientRole: true
    inventory-service:
    - name: inventory-admin
      description: Restock, release reservations, and create sites and stock records
        (create once)
      clientRole: true
    notification-service:
    - name: notification-reader
      description: Read operator notifications, their attempts and receipts, and
        the stub provider state
      clientRole: true
    - name: notification-fault-operator
      description: Switch the stub delivery provider's fault modes in an allowlisted
        demo namespace
      clientRole: true
    operations-console:
    - name: console-viewer
      description: Read every box1 Operations console page
      clientRole: true
    - name: console-operator
      description: Console viewer, plus place orders through the console
      clientRole: true
    - name: console-developer
      description: Console viewer, plus deployed source revisions
      clientRole: true
    scenario-controller:
    - name: scenario-viewer
      description: Read the scenario catalog, runs and audit trail
      clientRole: true
    - name: scenario-operator
      description: Scenario viewer, plus start, stop and reset scenarios and seed
        the demo fixtures
      clientRole: true
clients:
- clientId: agentic-operations-cli
  name: box1 agentic operations CLI and MCP
  enabled: true
  protocol: openid-connect
  publicClient: true
  standardFlowEnabled: true
  implicitFlowEnabled: false
  directAccessGrantsEnabled: false
  serviceAccountsEnabled: false
  fullScopeAllowed: false
  redirectUris:
  - http://127.0.0.1/*
  - http://localhost/*
  attributes:
    pkce.code.challenge.method: S256
    oauth2.device.authorization.grant.enabled: 'true'
  defaultClientScopes:
  - profile
  - roles
  optionalClientScopes: []
  protocolMappers:
  - name: agentic-operations-audience
    protocol: openid-connect
    protocolMapper: oidc-audience-mapper
    consentRequired: false
    config:
      included.client.audience: agentic-operations
      access.token.claim: 'true'
      id.token.claim: 'false'
- id: e7f3076c-02cd-405f-a148-3e4e0c2307b9
  clientId: agentic-operations
  name: box1 agentic operations
  enabled: true
  protocol: openid-connect
  publicClient: false
  bearerOnly: true
  standardFlowEnabled: false
  implicitFlowEnabled: false
  directAccessGrantsEnabled: false
  serviceAccountsEnabled: false
  fullScopeAllowed: false
  defaultClientScopes: []
  optionalClientScopes: []
- id: 0b509c04-6761-4cc3-af7d-be7ac1c7c743
  clientId: asset-service
  name: Asset telemetry service
  enabled: true
  protocol: openid-connect
  publicClient: true
  standardFlowEnabled: true
  implicitFlowEnabled: false
  directAccessGrantsEnabled: false
  serviceAccountsEnabled: false
  fullScopeAllowed: false
  redirectUris:
  - https://asset-service-dev.{{ .Values.deployer.domain }}/console/*
  webOrigins:
  - https://asset-service-dev.{{ .Values.deployer.domain }}
  attributes:
    pkce.code.challenge.method: S256
    post.logout.redirect.uris: https://asset-service-dev.{{ .Values.deployer.domain }}/signed-out.html
  defaultClientScopes:
  - profile
  - roles
  - web-origins
  optionalClientScopes: []
  protocolMappers:
  - name: asset-service-audience
    protocol: openid-connect
    protocolMapper: oidc-audience-mapper
    consentRequired: false
    config:
      included.client.audience: asset-service
      access.token.claim: 'true'
      id.token.claim: 'false'
