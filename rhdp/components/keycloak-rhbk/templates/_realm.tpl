  enabled: true
  protocol: openid-connect
  publicClient: false
  standardFlowEnabled: true
  implicitFlowEnabled: false
  directAccessGrantsEnabled: false
  serviceAccountsEnabled: false
  redirectUris:
  - https://acs.{{ .Values.deployer.domain }}/sso/providers/oidc/callback
  - https://acs.{{ .Values.deployer.domain }}:443/sso/providers/oidc/callback
  webOrigins:
  - https://acs.{{ .Values.deployer.domain }}
  defaultClientScopes:
  - profile
  - email
  - roles
  optionalClientScopes:
  - offline_access
# RHTPA browser login (public, PKCE). The rhtpa-admin realm role is exposed
# to it through a realm scope mapping added by the reconcile Job.
- clientId: rhtpa-frontend
  name: Box1 RHTPA browser
  enabled: true
  protocol: openid-connect
  publicClient: true
  standardFlowEnabled: true
  implicitFlowEnabled: false
  directAccessGrantsEnabled: false
  serviceAccountsEnabled: false
  fullScopeAllowed: false
  redirectUris:
