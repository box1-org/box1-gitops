  attributes:
    pkce.code.challenge.method: S256
  defaultClientScopes:
  - profile
  - email
  - roles
  optionalClientScopes: []
  protocolMappers:
  - name: audience
    protocol: openid-connect
    protocolMapper: oidc-audience-mapper
    consentRequired: false
    config:
      included.client.audience: rhtpa-frontend
      access.token.claim: 'true'
      id.token.claim: 'false'
# RHTPA CI ingestion (client credentials).
- clientId: rhtpa-ci
  name: Box1 RHTPA CI ingestion
